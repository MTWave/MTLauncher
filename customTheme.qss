QWidget {
    background-color: black;
    color: white;
}
QPushButton {
    background-color: purple;
    color: white;
    border: 3px solid red;
    border-radius: 7px;
    padding: 4px 8px;
}
QLineEdit {
    border: 3px solid blue;
    border-radius: 7px;
    color: red;
}

QPushButton:hover {
    border: 3px solid green;
}
